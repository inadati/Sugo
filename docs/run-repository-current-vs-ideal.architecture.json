  "cards": [
    {
      "dot": "rose",
      "title": "現状の欠陥",
      "items": [
        "update(&Run) はこのコードベースで唯一のエンティティ型の書き込み",
        "型は11フィールド、SQLite は3カラム — 差分は無言で消える",
        "RunRepository には契約テストが一つも無い"
      ]
    },
    {
      "dot": "amber",
      "title": "update を広げるのは誤った修正",
      "items": [
        "heartbeat は callback HTTP が別プロセスから書く",
        "全カラム UPDATE にすると古い heartbeat で上書きしてしまう",
        "狭いこと自体は正しく、狭さが型に現れていないのが問題"
      ]
    },
    {
      "dot": "emerald",
      "title": "理想への2手",
      "items": [
        "先に RunRepository の契約テストを足し、乖離を検出可能にする",
        "次に update を set_position / set_status に割る",
        "stop_run の3回の非アトミックな書き込みも1文になる"
      ]
    }
  ]
